.SH NAME
tagents-completion - Generate shell completion scripts


.SH SYNOPSIS
\fBtagents completion [bash|zsh|fish|powershell]\fP


.SH DESCRIPTION
Generate shell completion scripts for tagents.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for completion


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--all-machines\fP[=false]
	Target all hosts from SSH config

.PP
\fB--debug\fP[=false]
	Verbose logging to stderr

.PP
\fB--fields\fP=""
	Comma-separated fields to include in output

.PP
\fB--jq\fP=""
	JQ expression to filter JSON output

.PP
\fB-j\fP, \fB--json\fP[=false]
	JSON output

.PP
\fB--machine\fP=""
	Target a specific SSH host

.PP
\fB--no-color\fP[=false]
	Disable colored output

.PP
\fB-p\fP, \fB--plaintext\fP[=false]
	Tab-separated output for piping

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output (alias for --debug)


.SH EXAMPLE
.EX
  tagents completion bash > /etc/bash_completion.d/tagents
  tagents completion zsh > "${fpath[1]}/_tagents"
  tagents completion fish > ~/.config/fish/completions/tagents.fish
.EE


